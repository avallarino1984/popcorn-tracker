@page "/"
@inject OutingService Outings
@inject CinemaOptions Cinema

<PageTitle>Popcorn Tracker</PageTitle>

@if (_loading)
{
    <div class="skeleton hero-skel"></div>
    <div class="skeleton card-skel"></div>
    <div class="skeleton card-skel"></div>
}
else if (_error is not null)
{
    <div class="empty-state">
        <div class="empty-emoji">📡</div>
        <h2>Impossible de charger les sorties</h2>
        <p class="muted">@_error</p>
        <button class="btn primary" @onclick="LoadAsync">Réessayer</button>
    </div>
}
else if (_people.Count == 0)
{
    <div class="empty-state">
        <div class="empty-emoji">👋</div>
        <h2>Bienvenue!</h2>
        <p class="muted">Commence par ajouter les personnes qui vont au cinéma ensemble.</p>
        <a class="btn primary" href="personnes">Ajouter des personnes</a>
    </div>
}
else
{
    <section class="next-card">
        <div class="eyebrow">Sortie à ajouter · c'est au tour de</div>
        <div class="next-grid">
            <div class="next-item">
                <span class="next-emoji">🎟️</span>
                <span class="next-label">Entrées</span>
                <span class="next-who"><Avatar Person="@Find(_next.Tickets)" />@Find(_next.Tickets)?.Name</span>
            </div>
            <div class="next-item">
                <span class="next-emoji">🍿</span>
                <span class="next-label">Popcorn</span>
                <span class="next-who"><Avatar Person="@Find(_next.Popcorn)" />@Find(_next.Popcorn)?.Name</span>
            </div>
        </div>
        <div class="next-actions">
            <a class="btn primary" href="sortie/nouvelle">🎬 Nouvelle sortie</a>
            @if (!string.IsNullOrWhiteSpace(Cinema.ScheduleUrl))
            {
                <a class="btn ghost" href="@Cinema.ScheduleUrl" target="_blank" rel="noopener">
                    Horaire · @Cinema.Name
                </a>
            }
        </div>
    </section>

    @if (_outings.Count == 0)
    {
        <div class="empty-state compact">
            <div class="empty-emoji">🍿</div>
            <p class="muted">Aucune sortie pour l'instant. Planifie la prochaine avec « Nouvelle sortie ».</p>
        </div>
    }

    @if (_schedule.Upcoming.Count > 0)
    {
        @* Planned outings (today and later), nearest first; the next one is shown bigger. *@
        <h2 class="section-title">
            Prochaines sorties <span class="count">@_schedule.Upcoming.Count</span>
        </h2>
        <div class="history">
            @for (var i = 0; i < _schedule.Upcoming.Count; i++)
            {
                var outing = _schedule.Upcoming[i];
                <OutingCard @key="outing.Id" Outing="outing" People="_people"
                            Featured="@(i == 0)" Badge="@OutingSchedule.RelativeLabel(outing.Date, _today)" />
            }
        </div>
    }

    @if (_schedule.Past.Count > 0)
    {
        <h2 class="section-title">
            Historique <span class="count">@_schedule.Past.Count</span>
        </h2>
        <div class="history">
            @foreach (var outing in _schedule.Past)
            {
                <OutingCard @key="outing.Id" Outing="outing" People="_people" />
            }
        </div>
    }
}

@code {
    private bool _loading = true;
    private string? _error;
    private List<Person> _people = [];
    private List<Outing> _outings = [];
    private NextPayers _next = new(null, null);
    private ScheduledOutings _schedule = new([], []);

    // Local date of the device; decides what counts as upcoming vs history.
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            // Sequential on purpose: two parallel calls could both try to renew an expiring session.
            _people = await Outings.GetPeopleAsync();
            _outings = await Outings.GetOutingsAsync();

            _today = DateOnly.FromDateTime(DateTime.Today);
            _schedule = OutingSchedule.Split(_outings, _today);

            // Outings come newest date first, planned ones included, so the suggestion
            // is for the outing that would be added after the last one already planned.
            _next = PaymentRotation.Suggest(_people, _outings);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Person? Find(Guid? id) => id is null ? null : _people.FirstOrDefault(p => p.Id == id);
}
