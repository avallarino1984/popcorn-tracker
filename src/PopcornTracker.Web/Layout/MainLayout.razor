@inherits LayoutComponentBase
@implements IDisposable
@inject SupabaseClient Supabase

@if (!_ready)
{
    <div class="boot">
        <div class="boot-mark">🍿</div>
        <div class="boot-text">Les lumières s'éteignent…</div>
    </div>
}
else if (!Supabase.IsConfigured)
{
    <div class="shell">
        <div class="banner">
            Supabase n'est pas configuré. Ajoute l'URL et la clé publishable dans <code>wwwroot/appsettings.json</code>.
        </div>
    </div>
}
else if (!_signedIn)
{
    <div class="shell">
        <LoginCard OnSignedIn="OnSignedIn" />
    </div>
}
else
{
    <div class="shell">
        <header class="topbar">
            <a href="" class="brand">
                <span class="brand-mark">🍿</span>
                <span class="brand-text">Popcorn<em>Tracker</em></span>
            </a>
        </header>

        <main class="content">
            @Body
        </main>

        <nav class="bottomnav" aria-label="Navigation principale">
            <NavLink href="" Match="NavLinkMatch.All" class="navitem">
                <span class="nav-ico">🎬</span><span>Sorties</span>
            </NavLink>
            <NavLink href="sortie/nouvelle" class="navitem nav-add" aria-label="Nouvelle sortie">
                <span class="nav-plus">+</span>
            </NavLink>
            <NavLink href="personnes" class="navitem">
                <span class="nav-ico">👥</span><span>Personnes</span>
            </NavLink>
        </nav>
    </div>
}

@code {
    private bool _ready;
    private bool _signedIn;

    protected override async Task OnInitializedAsync()
    {
        Supabase.SignedOut += OnSignedOut;

        // The session is read from localStorage, so the app opens directly when already signed in.
        _signedIn = Supabase.IsConfigured && await Supabase.IsSignedInAsync();
        _ready = true;
    }

    private void OnSignedIn() => _signedIn = true;

    // Back to the sign-in screen when the user signs out or the session can no longer be renewed.
    private void OnSignedOut() => InvokeAsync(() =>
    {
        _signedIn = false;
        StateHasChanged();
    });

    public void Dispose() => Supabase.SignedOut -= OnSignedOut;
}
